# Copy to box/box.env (git-ignored) and fill in. Restart the box after editing:
#   docker compose -f box/compose.yaml up -d
#
# Every agent in the box can read these values, so only put low-risk keys here.

# Trello: lets the concierge mirror sprint status to your board (one-way, status only).
# Get both at https://trello.com/power-ups/admin  ->  your Power-Up  ->  API key  ->  Token
TRELLO_KEY=
TRELLO_TOKEN=
# The "Garageband build" board (https://trello.com/b/qjhCSnQQ/garageband-build)
TRELLO_BOARD_ID=6ad1f20b91521bf367f4c518

# OpenCode Go API key: lets T3 show OpenCode Go session/weekly/monthly limits,
# which the orchestrator uses for quota pacing. Same key as your OpenCode Go login.
OPENCODE_API_KEY=
