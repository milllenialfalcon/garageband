#!/usr/bin/env bash
# Garageband pre-push guard. Works for every agent and every tool, because git runs it.
# Install once per clone:  git config core.hooksPath .githooks
# Blocks: pushing to main/master, force-pushing (rewriting history), and obvious secrets.
set -euo pipefail

protected='^refs/heads/(main|master|production)$'
zero='0000000000000000000000000000000000000000'
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue

  if [[ "$remote_ref" =~ $protected ]]; then
    echo "garageband: blocked push to ${remote_ref#refs/heads/}. Open a pull request; only the founder merges to main." >&2
    fail=1
    continue
  fi

  # Deleting a remote branch
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi

  # Force push: the remote tip is not an ancestor of what we're pushing
  if [ "$remote_sha" != "$zero" ]; then
    if git cat-file -e "$remote_sha" 2>/dev/null && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
      echo "garageband: blocked force push to ${remote_ref#refs/heads/}. History rewrites need a Founder Call." >&2
      fail=1
      continue
    fi
    range="$remote_sha..$local_sha"
  else
    range="$local_sha"
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
    [ -n "$base" ] && range="$base..$local_sha"
  fi

  # Cheap secret scan on the lines being pushed (CI runs a full scan too)
  if git diff "$range" --unified=0 2>/dev/null | grep -E '^\+' | grep -Eq \
    '(AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|sk-[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{36}|xox[baprs]-[A-Za-z0-9-]{10,}|rzp_live_[A-Za-z0-9]{10,}|sk_live_[A-Za-z0-9]{10,})'; then
    echo "garageband: blocked push, a line looks like a secret key. Move it to the secret manager and rotate the key." >&2
    fail=1
  fi
done

exit $fail
