# Copy to .env.local for development. Never commit real values.
# Real values live in the hosting provider's secret manager and in GitHub Actions secrets.
# Every variable the app reads must be listed here, with a comment saying what it's for.

# Database connection (server only)
DATABASE_URL=

# Auth provider (server only)
AUTH_SECRET=

# Error tracking (public DSN is safe to expose)
NEXT_PUBLIC_SENTRY_DSN=

# Product analytics (public key is safe to expose)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Payments (server only; use test keys outside production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
